      "method": "https-get"
    }
  ],
  "verification": "mock-only",
  "providerLiveValidation": "not-run",
  "workflow": {
    "name": "Manage a short-lived browser session",
    "description": "Inspect existing sessions, approve creation only if needed, then request release of the returned session ID and inspect its final state. Actual browser driving requires a separate CDP client.",
    "steps": [
      "list_sessions",
      "create_session",
      "release_session",
      "get_session"
    ]
  },
