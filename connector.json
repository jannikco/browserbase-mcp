{
  "id": "browserbase",
  "name": "Browserbase",
  "version": "0.1.0",
  "baseUrl": "https://api.browserbase.com",
  "auth": {
    "type": "header",
    "env": "BROWSERBASE_API_KEY",
    "header": "X-BB-API-Key"
  },
  "description": "Inspect session metadata and explicitly approve short-lived cloud browser session creation/release. This JSON connector does not drive CDP, Playwright or web page actions.",
  "tools": [
    {
      "name": "list_sessions",
      "description": "List sessions, optionally filtered by provider status.",
      "method": "GET",
      "path": "/v1/sessions",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "RUNNING",
              "ERROR",
              "TIMED_OUT",
              "COMPLETED"
            ]
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {
          "status": "status"
        },
        "body": {}
      },
      "sampleArguments": {
        "status": "RUNNING"
      },
      "provenance": [
        "https://docs.browserbase.com/reference/api/openapi.v1.yaml"
      ]
    },
    {
      "name": "get_session",
      "description": "Inspect a session’s lifecycle metadata. Treat returned connection URLs and signing information as sensitive; no browser navigation is performed.",
      "method": "GET",
      "path": "/v1/sessions/{id}",
      "readOnly": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [
          "id"
        ],
        "query": {},
        "body": {}
      },
      "sampleArguments": {
        "id": "00000000-0000-4000-8000-000000000001"
      },
      "provenance": [
        "https://docs.browserbase.com/reference/api/openapi.v1.yaml"
      ]
    },
    {
      "name": "create_session",
      "description": "Create a billable short-lived session only after explicit approval; release it when done or wait for provider timeout.",
      "method": "POST",
      "path": "/v1/sessions",
      "readOnly": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "timeout": {
            "type": "integer",
            "minimum": 60,
            "maximum": 300
          }
        },
        "required": [
          "timeout"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {},
        "body": {
          "projectId": "projectId",
          "timeout": "timeout"
        }
      },
      "sampleArguments": {
        "projectId": "00000000-0000-4000-8000-000000000002",
        "timeout": 60
      },
      "provenance": [
        "https://docs.browserbase.com/reference/api/openapi.v1.yaml"
      ]
    },
    {
      "name": "release_session",
      "description": "Request early release of the chosen session after approval; inspect returned lifecycle state rather than assuming completion.",
      "method": "POST",
      "path": "/v1/sessions/{id}",
      "readOnly": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [
          "id"
        ],
        "query": {},
        "body": {}
      },
      "sampleArguments": {
        "id": "00000000-0000-4000-8000-000000000001"
      },
      "provenance": [
        "https://docs.browserbase.com/reference/api/openapi.v1.yaml"
      ],
      "body": {
        "status": "REQUEST_RELEASE"
      }
    }
  ],
  "provenance": [
    "https://docs.browserbase.com/reference/api/openapi.v1.yaml"
  ],
  "sourceEvidence": [
    {
      "url": "https://docs.browserbase.com/reference/api/openapi.v1.yaml",
