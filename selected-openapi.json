{
  "openapi": "3.1.0",
  "info": {
    "title": "Browserbase selected operations",
    "version": "0.1.0",
    "description": "Reviewed local connector bindings for manual API import. No provider credentials are included; authentication and hosted execution require separate configuration and tests."
  },
  "servers": [
    {
      "url": "https://api.browserbase.com"
    }
  ],
  "paths": {
    "/v1/sessions": {
      "get": {
        "operationId": "list_sessions",
        "summary": "List sessions, optionally filtered by provider status.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "PENDING",
                "RUNNING",
                "ERROR",
                "TIMED_OUT",
                "COMPLETED"
              ]
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      },
      "post": {
        "operationId": "create_session",
        "summary": "Create a billable short-lived session only after explicit approval; release it when done or wait for provider timeout.",
        "parameters": [],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "projectId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "timeout": {
                    "type": "integer",
                    "minimum": 60,
                    "maximum": 300
                  }
                },
                "required": [
                  "timeout"
                ]
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{id}": {
      "get": {
        "operationId": "get_session",
        "summary": "Inspect a session’s lifecycle metadata. Treat returned connection URLs and signing information as sensitive; no browser navigation is performed.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "x-pipmcp-read-only": true,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        }
      },
      "post": {
        "operationId": "release_session",
        "summary": "Request early release of the chosen session after approval; inspect returned lifecycle state rather than assuming completion.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        ],
        "x-pipmcp-read-only": false,
        "responses": {
          "200": {
            "description": "Provider response; inspect provider documentation for result fields."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "const": "REQUEST_RELEASE",
                    "default": "REQUEST_RELEASE"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "providerAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-BB-API-Key"
      }
    }
  },
  "security": [
    {
      "providerAuth": []
    }
  ]
}
